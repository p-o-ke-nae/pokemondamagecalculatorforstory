@model IReadOnlyList<PokemonDamageCalculatorForStory.Application.DTOs.Admin.AdminUserAuthorizationDto>
@{
    ViewData["Title"] = "User Authorizations";
}
<div class="card">
    <h1>User Authorization 管理</h1>
    <p class="muted">検索はクライアント側フィルタリングで実装しています。</p>
    <div class="actions">
        <input id="userAuthorizationFilter" type="text" placeholder="googleUserId / role / permission で検索" />
        <a href="/admin/masters/user-authorizations/new">新規作成</a>
    </div>
</div>
<div class="card">
    <table id="userAuthorizationTable">
        <thead>
        <tr>
            <th>Google User ID</th>
            <th>Role</th>
            <th>Permissions</th>
            <th>Last Administrator</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr data-filter="@($"{item.GoogleUserId} {item.Role} {string.Join(' ', item.Permissions)}".ToLowerInvariant())">
                <td><a href="/admin/masters/user-authorizations/@item.GoogleUserId">@item.GoogleUserId</a></td>
                <td>@item.Role</td>
                <td>@string.Join(", ", item.Permissions)</td>
                <td>@(item.IsLastAdministrator ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<script>
document.getElementById('userAuthorizationFilter').addEventListener('input', function () {
  const term = this.value.toLowerCase();
  document.querySelectorAll('#userAuthorizationTable tbody tr').forEach(row => {
    row.style.display = row.dataset.filter.includes(term) ? '' : 'none';
  });
});
</script>
