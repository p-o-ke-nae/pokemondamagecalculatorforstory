@model PokemonDamageCalculatorForStory.ViewModels.Admin.AdminRuleSetEditorViewModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="card">
    <h1>@Model.Heading</h1>
    @Html.ValidationSummary(excludePropertyErrors: false)
    @if (Model.IsReferencedByRuns)
    {
        <p class="warning">この RuleSet は Run から参照されているため削除できません。</p>
    }
    <form method="post" action="@(Model.Id.HasValue ? $"/admin/masters/rule-sets/{Model.Id}" : "/admin/masters/rule-sets/new")" data-unsaved-warning="true">
        @Html.AntiForgeryToken()
        <label>Slug</label>
        <input type="text" name="Slug" value="@Model.Form.Slug" maxlength="100" pattern="^[a-z0-9-]+$" required />
        @Html.ValidationMessage("Slug")
        <label>Generation</label>
        <input type="number" name="Generation" value="@Model.Form.Generation" min="1" required />
        @Html.ValidationMessage("Generation")
        <label>Title</label>
        <input type="text" name="Title" value="@Model.Form.Title" maxlength="200" required />
        @Html.ValidationMessage("Title")
        <label>Version</label>
        <input type="text" name="Version" value="@Model.Form.Version" maxlength="50" required />
        @Html.ValidationMessage("Version")
        <label>Status</label>
        <select name="Status" required>
            @foreach (var status in Model.StatusOptions)
            {
                <option value="@status" selected="@(status == Model.Form.Status ? "selected" : null)">@status</option>
            }
        </select>
        @Html.ValidationMessage("Status")
        <label>Summary</label>
        <textarea name="Summary" maxlength="500">@Model.Form.Summary</textarea>
        @Html.ValidationMessage("Summary")
        <div class="actions">
            <button type="submit">保存</button>
            <a href="/admin/masters/rule-sets">一覧へ戻る</a>
        </div>
    </form>
    @if (Model.Id.HasValue)
    {
        <form method="post" action="/admin/masters/rule-sets/@Model.Id/delete" onsubmit="return confirm('削除しますか？');">
            @Html.AntiForgeryToken()
            <button type="submit" disabled="@(Model.IsReferencedByRuns ? "disabled" : null)">削除</button>
        </form>
    }
</div>
