@model IReadOnlyList<PokemonDamageCalculatorForStory.Application.DTOs.Admin.AdminRuleSetDto>
@{
    ViewData["Title"] = "RuleSets";
}
<div class="card">
    <h1>RuleSet 管理</h1>
    <p class="muted">検索はクライアント側フィルタリングで実装しています。</p>
    <div class="actions">
        <input id="ruleSetFilter" type="text" placeholder="slug / title / version / status で検索" />
        <a href="/admin/masters/rule-sets/new">新規作成</a>
    </div>
</div>
<div class="card">
    <table id="ruleSetTable">
        <thead>
        <tr>
            <th>Slug</th>
            <th>Title</th>
            <th>Generation</th>
            <th>Version</th>
            <th>Status</th>
            <th>参照中</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr data-filter="@($"{item.Slug} {item.Title} {item.Generation} {item.Version} {item.Status}".ToLowerInvariant())">
                <td><a href="/admin/masters/rule-sets/@item.Id">@item.Slug</a></td>
                <td>@item.Title</td>
                <td>@item.Generation</td>
                <td>@item.Version</td>
                <td>@item.Status</td>
                <td>@(item.IsReferencedByRuns ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<script>
document.getElementById('ruleSetFilter').addEventListener('input', function () {
  const term = this.value.toLowerCase();
  document.querySelectorAll('#ruleSetTable tbody tr').forEach(row => {
    row.style.display = row.dataset.filter.includes(term) ? '' : 'none';
  });
});
</script>
