<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <style>
        body { font-family: sans-serif; margin: 0; background: #f5f7fb; color: #1f2937; }
        header, main { max-width: 1080px; margin: 0 auto; padding: 16px; }
        header { display: flex; justify-content: space-between; align-items: center; }
        nav a { margin-right: 12px; }
        .card { background: white; border-radius: 8px; padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
        .flash-success { background: #ecfdf5; color: #065f46; padding: 12px; border-radius: 6px; margin-bottom: 16px; }
        .flash-error, .validation-summary-errors { background: #fef2f2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 16px; }
        .field-validation-error { color: #991b1b; display: block; margin-top: 4px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border-bottom: 1px solid #e5e7eb; padding: 8px; text-align: left; vertical-align: top; }
        label { display: block; font-weight: 600; margin-top: 12px; }
        input[type=text], input[type=number], select, textarea { width: 100%; padding: 8px; box-sizing: border-box; }
        .actions { display: flex; gap: 8px; margin-top: 16px; }
        .muted { color: #6b7280; }
        .warning { color: #92400e; }
        .checkbox-list label { font-weight: 400; margin-top: 4px; }
    </style>
</head>
<body>
<header>
    <div>
        <strong>PokemonDamageCalculatorForStory Admin</strong>
        <nav>
            @if (User.IsInRole("Administrator") || User.IsInRole("MasterEditor"))
            {
                <a href="/admin/masters/rule-sets">RuleSets</a>
            }
            @if (User.IsInRole("Administrator"))
            {
                <a href="/admin/masters/user-authorizations">User Authorizations</a>
            }
        </nav>
    </div>
    <form method="post" action="/admin/logout">
        @Html.AntiForgeryToken()
        <button type="submit">Logout</button>
    </form>
</header>
<main>
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="flash-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="flash-error">@errorMessage</div>
    }
    @RenderBody()
</main>
<script>
(() => {
    const form = document.querySelector('form[data-unsaved-warning="true"]');
    if (!form) {
        return;
    }

    const serialize = () => new URLSearchParams(new FormData(form)).toString();
    const initialState = serialize();
    let isSubmitting = false;

    form.addEventListener('submit', () => {
        isSubmitting = true;
    });

    window.addEventListener('beforeunload', event => {
        if (isSubmitting || serialize() === initialState) {
            return;
        }

        event.preventDefault();
        event.returnValue = '';
    });
})();
</script>
</body>
</html>
